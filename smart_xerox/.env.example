# Copy this file to .env and edit values if needed.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True

# Default: SQLite, so the project runs immediately.
DB_ENGINE=sqlite

# Optional MySQL settings (set DB_ENGINE=mysql)
DB_NAME=smart_xerox
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Keep DEMO_PAYMENT=True for local testing without real money.
# For Razorpay test mode, set DEMO_PAYMENT=False and add test keys.
DEMO_PAYMENT=True
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
